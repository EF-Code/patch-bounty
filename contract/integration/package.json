{
  "name": "patchbounty-escrow-integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo +1.86.0 build --manifest-path ../Cargo.toml --target wasm32-unknown-unknown --release --locked && wasm-opt ../target/wasm32-unknown-unknown/release/patchbounty_escrow.wasm -o ../target/wasm32-unknown-unknown/release/patchbounty_escrow_near.wasm --enable-bulk-memory --enable-sign-ext --enable-nontrapping-float-to-int --signext-lowering --llvm-memory-copy-fill-lowering --llvm-nontrapping-fptoint-lowering",
    "test": "node sandbox.mjs"
  },
  "dependencies": {
    "near-workspaces": "5.0.0"
  },
  "devDependencies": {
    "binaryen": "123.0.0"
  }
}
